<!DOCTYPE html>
<html lang="en">
<!--
  Generated per invention at /<id>/index.html and at the site root.
  Body is the universe shell; the pinned invention is read from location.pathname by universe.js.
-->

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
  <title>{{title}}</title>
  <meta name="description" content="{{description}}">
  <link rel="canonical" href="{{canonical_url}}">
  <meta name="author" content="Boris Smus">

  <meta property="og:type" content="{{og_type}}" />
  <meta property="og:title" content="{{title}}" />
  <meta property="og:site_name" content="{{site_name}}" />
  <meta property="og:url" content="{{canonical_url}}" />
  <meta property="og:image" content="{{card_image_url}}" />
  <meta property="og:description" content="{{description}}" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{title}}" />
  <meta name="twitter:description" content="{{description}}" />
  <meta name="twitter:image" content="{{card_image_url}}" />

  <script type="application/ld+json">{{jsonld | safe}}</script>

  <link rel="stylesheet" href="/static/style.css">
  <link rel="stylesheet" href="/static/card.css">
  <link rel="stylesheet" href="/static/universe.css" media="(min-width: 721px)">
  <link rel="stylesheet" href="/static/stories.css" media="(min-width: 721px)">
  <link rel="stylesheet" href="/static/mobile.css" media="(max-width: 720px)">
  <link rel="icon" type="image/x-icon" href="/static/images/icons/favicon.ico">
</head>

<body>
  <noscript>
    <h1>{{heading}}</h1>
    <p>{{description}}</p>
    <img src="{{card_image_url}}" alt="{{description}}" />
  </noscript>

  <header id="site-header">
    <div class="site-header-top">
      <div class="site-titles">
        <h1 class="site-title">Invention Cards</h1>
        <p class="site-subtitle">A visual chronology of Asimov's ~1500 scientific inventions and discoveries.</p>
      </div>
      <div class="site-actions">
        <button id="action-stories" class="site-action" type="button" title="Stories" aria-label="Stories">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 19.5V5a2 2 0 0 1 2-2h12v18l-6-3-6 3z"/>
          </svg>
        </button>
        <button id="action-random" class="site-action" type="button" title="Random card" aria-label="Random card">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="3"/>
            <circle cx="8" cy="8" r="1.2" fill="#444"/>
            <circle cx="16" cy="16" r="1.2" fill="#444"/>
            <circle cx="16" cy="8" r="1.2" fill="#444"/>
            <circle cx="8" cy="16" r="1.2" fill="#444"/>
          </svg>
        </button>
        <button id="action-search" class="site-action" type="button" title="Search" aria-label="Search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"/>
            <line x1="16.5" y1="16.5" x2="21" y2="21"/>
          </svg>
        </button>
        <a id="site-help" class="site-action" href="https://smus.com/visual-chronology-science-discovery-v2"
           target="_blank" rel="noopener" title="About this project" aria-label="About this project">
          <span class="site-help-mark" aria-hidden="true">?</span>
        </a>
      </div>
    </div>
    <div id="site-timeline"></div>
  </header>
  <canvas id="links-canvas"></canvas>
  <div id="container"></div>
  <div id="offscreen-indicators"></div>
  <input id="search-input" type="search" placeholder="Search…" autocomplete="off" spellcheck="false" />
  <div id="search-results"></div>
  <div id="stories-menu" data-open="false"></div>
  <div id="story-banner"></div>
  <div id="story-card-chip" hidden></div>
  <div id="onboard-hint" hidden>
    <span class="onboard-hint-icon" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 9l-3 3 3 3"/>
        <path d="M9 5l3-3 3 3"/>
        <path d="M15 19l-3 3-3-3"/>
        <path d="M19 9l3 3-3 3"/>
        <path d="M2 12h20"/>
        <path d="M12 2v20"/>
      </svg>
    </span>
    <span class="onboard-hint-text">Drag to pan, scroll to zoom</span>
  </div>
  <div id="app-confirm" hidden>
    <div class="confirm-backdrop"></div>
    <div class="confirm-card" role="dialog" aria-modal="true">
      <p class="confirm-title"></p>
      <div class="confirm-actions"></div>
    </div>
  </div>
  <button id="story-prev-btn" class="story-nav-btn" type="button" aria-label="Previous step">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="15 18 9 12 15 6"/>
    </svg>
  </button>
  <button id="story-next-btn" class="story-nav-btn" type="button" aria-label="Next step">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="9 18 15 12 9 6"/>
    </svg>
  </button>

  <script src="https://d3js.org/d3.v7.min.js"></script>
  <script type="module">
    const mq = matchMedia("(max-width: 720px)");
    import(mq.matches ? "/static/mobile.js" : "/static/universe.js");
    // Crossing the breakpoint mid-session means the wrong bundle is loaded
    // (universe's D3 graph in a phone viewport, or mobile's flipper on a
    // wide one). Reload to pick up the right entry. Same-tab reload preserves
    // the URL hash so view state survives.
    mq.addEventListener("change", () => location.reload());
  </script>

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-02307ST8RC"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-02307ST8RC');
  </script>
</body>

</html>
